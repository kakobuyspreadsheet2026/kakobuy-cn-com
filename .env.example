# Copy to .env to override the default MaisonLooks outbound catalogue CTA URL
# Default if unset: https://maisonlooks.com/en (EN locale home)
PUBLIC_KAKOBUY_SPREADSHEET_URL=

# Prebuild (`npm run build`) refreshes category pools from the MaisonLooks API but keeps
# homepage Editor's Pick (`featured-products.json`) pinned unless you opt in:
# REFRESH_FEATURED=1

# TOP promo strip → `/join/discord` redirect (optional; default in src/consts.ts).
# PUBLIC_KAKOBUY_DISCORD_URL=https://discord.com/invite/9hrqg53zgs

# Floating right dock (Video / Discord / Reddit / WhatsApp). Optional overrides — see defaults in src/consts.ts (CDN intro MP4).
# PUBLIC_FLOAT_VIDEO_URL=https://example.com/my-intro.mp4
# PUBLIC_FLOAT_DISCORD_URL=https://discord.com/invite/9hrqg53zgs
# PUBLIC_FLOAT_REDDIT_URL=https://www.reddit.com/r/kakobuy/
# PUBLIC_FLOAT_WHATSAPP_URL=https://wa.me/447594927259
