---
import { absoluteCanonicalUrl } from '../../../../lib/canonicalPath';
import Layout from '../../../../layouts/Layout.astro';
import BlogPageBody from '../../../../components/pages/BlogPageBody.astro';
import blogPosts from '../../../../data/blogPosts.json';
import { siteStructuredDataIds } from '../../../../consts';
import { getBlogCopy } from '../../../../i18n/copy/blogPage';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { HTML_LANG_BY_ROUTE } from '../../../../i18n/config';
import { breadcrumbListLd } from '../../../../lib/breadcrumbSchema';
import {
  blogListingCanonicalPath,
  formatBlogListingPageTitle,
  getBlogListingForPage,
  getBlogPaginationParamNs,
  getBlogPaginationRelUrls,
} from '../../../../lib/blogPagination';

export const prerender = true;

export function getStaticPaths() {
  return getBlogPaginationParamNs(blogPosts.length).map((n) => ({ params: { n } }));
}

const locale = 'es';
const pageNum = Number(Astro.params.n);
const { posts: listingPosts, totalPages, currentPage } = getBlogListingForPage(blogPosts, pageNum);
const canonicalPath = blogListingCanonicalPath(`/${locale}`, currentPage);
const copy = getBlogCopy(locale);
const layoutTitle = formatBlogListingPageTitle(
  copy.title,
  currentPage,
  copy.paginationTitleAffixBeforePipeTemplate,
);
const homeHref = getRelativeLocaleUrl(locale, '');

const origin = Astro.site?.origin ?? 'https://kakobuy-cn.com';
const { websiteId } = siteStructuredDataIds(origin);
const pageUrl = absoluteCanonicalUrl(canonicalPath, Astro.site);
const homeAbs = new URL(homeHref, Astro.site).href;

const { prevUrl, nextUrl } = getBlogPaginationRelUrls(origin, `/${locale}`, currentPage, totalPages);

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${pageUrl}#webpage`,
  name: layoutTitle,
  url: pageUrl,
  description: copy.description,
  inLanguage: HTML_LANG_BY_ROUTE[locale],
  isPartOf: { '@id': websiteId },
};

const breadcrumbLd = breadcrumbListLd([
  { name: copy.breadcrumbHomeLabel, url: homeAbs },
  { name: copy.h1, url: pageUrl },
]);
---

<Layout
  title={layoutTitle}
  description={copy.description}
  canonicalPath={canonicalPath}
  locale={locale}
  i18nRouteSegment="blog"
  jsonLd={[webPageLd, breadcrumbLd]}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
>
  <BlogPageBody
    locale={locale}
    copy={copy}
    homeHref={homeHref}
    posts={listingPosts}
    listingPage={currentPage}
    totalListingPages={totalPages}
    breadcrumbUi={[
      { label: copy.breadcrumbHomeLabel, href: homeHref },
      { label: copy.h1 },
    ]}
  />
</Layout>
