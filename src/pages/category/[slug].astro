---
import { absoluteCanonicalUrl } from '../../lib/canonicalPath';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CategoryProductCatalog from '../../components/CategoryProductCatalog.astro';
import { siteStructuredDataIds } from '../../consts';
import categories from '../../data/api/categories.json';
import categoryProducts from '../../data/api/category-products.json';
import { enHome } from '../../i18n/stubs/en';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { filterRenderableCatalogProducts } from '../../lib/catalogProducts';
import { productDetailAbsoluteUrl } from '../../lib/productDetailRoutes';
import { productSchemaRatingFields } from '../../lib/productAggregateRating';
import { getCategorySeoCopy } from '../../lib/categorySeoCopy';
import { breadcrumbListLd } from '../../lib/breadcrumbSchema';

export const prerender = true;

const mapping = {
  'shoes': 'sneakers',
  't-shirts': 't-shirts',
  'pants': 'trousers-pants',
  'accessories': 'accessories',
  'bags': 'bags-backpacks',
  'electronics': 'electronics',
  'jackets': 'jackets',
  'hoodies': 'hoodies-sweatshirts',
  'headwear': 'headwear',
  'jersey': 'jersey',
  'perfume': 'perfume',
  'other': 'clothing'
};

export function getStaticPaths() {
  const mapping = {
    'shoes': 'sneakers',
    't-shirts': 't-shirts',
    'pants': 'trousers-pants',
    'accessories': 'accessories',
    'bags': 'bags-backpacks',
    'electronics': 'electronics',
    'jackets': 'jackets',
    'hoodies': 'hoodies-sweatshirts',
    'headwear': 'headwear',
    'jersey': 'jersey',
    'perfume': 'perfume',
    'other': 'clothing'
  };

  return Object.keys(mapping).map((uiSlug) => {
    const apiSlug = mapping[uiSlug];
    return {
      params: { slug: uiSlug },
      props: { 
        apiSlug, 
        uiName: uiSlug.charAt(0).toUpperCase() + uiSlug.slice(1).replace('-', ' ') 
      }
    };
  });
}

const { slug } = Astro.params;
const { apiSlug, uiName } = Astro.props;

const locale = 'en';
const content = enHome;
const canonicalPath = `/category/${slug}`;
const products = filterRenderableCatalogProducts(categoryProducts[apiSlug] || []);

const uiNameLower = uiName.toLowerCase();
const { title, description } = getCategorySeoCopy(slug, uiName, locale);
const introText = content.categoryPage.introTemplate
  .replace('{uiNameLower}', uiNameLower);
const externalBtnText = content.categoryPage.externalBtnTemplate
  .replace('{uiName}', uiName);

const origin = Astro.site?.origin ?? 'https://kakobuy-cn.com';
const { websiteId } = siteStructuredDataIds(origin);
const pageUrl = absoluteCanonicalUrl(canonicalPath, Astro.site);

const breadcrumbLd = breadcrumbListLd([
  { name: 'Home', url: `${origin}/` },
  { name: uiName, url: pageUrl },
]);

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': title,
  'numberOfItems': products.length,
  'itemListElement': products.map((p, i) => ({
    '@type': 'ListItem',
    'position': i + 1,
    'item': {
      '@type': 'Product',
      'name': p.title,
      'image': p.images[0],
      'brand': { '@type': 'Brand', 'name': p.brand },
      'offers': {
        '@type': 'Offer',
        'price': p.priceUsdEstimate[0],
        'priceCurrency': 'USD',
        'url': productDetailAbsoluteUrl(locale, slug, p.slug, Astro.site),
        'availability': 'https://schema.org/InStock',
        'shippingDetails': {
          '@type': 'OfferShippingDetails',
          'shippingRate': {
            '@type': 'MonetaryAmount',
            'value': '5.00',
            'currency': 'USD'
          },
          'shippingDestination': {
            '@type': 'DefinedRegion',
            'addressCountry': 'US'
          },
          'deliveryTime': {
            '@type': 'ShippingDeliveryTime',
            'handlingTime': {
              '@type': 'QuantitativeValue',
              'minValue': 1,
              'maxValue': 3,
              'unitCode': 'd'
            },
            'transitTime': {
              '@type': 'QuantitativeValue',
              'minValue': 7,
              'maxValue': 15,
              'unitCode': 'd'
            }
          }
        },
        'hasMerchantReturnPolicy': {
          '@type': 'MerchantReturnPolicy',
          'applicableCountry': 'US',
          'returnPolicyCategory': 'MerchantReturnFiniteReturnPeriod',
          'merchantReturnDays': 7,
          'returnMethod': 'ReturnByMail',
          'returnFees': 'FreeReturn'
        }
      },
      ...productSchemaRatingFields(p.slug),
    }
  }))
};
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  locale={locale}
  jsonLd={[itemListLd, breadcrumbLd]}
>
  <SiteHeader locale={locale} />

  <main class="category-page">
    <section class="band-alt">
      <div class="wrap">
        <header class="page-head">
          <nav class="breadcrumb">
            <a href={getRelativeLocaleUrl(locale, '')}>Home</a> / <span>{uiName}</span>
          </nav>
          <h1 class="simple-page-title">{uiName} Spreadsheet 2026</h1>
          <p class="section-intro">
            {introText}
          </p>
          <div class="header-actions">
            <a 
              href={`https://maisonlooks.com/c/${apiSlug}`} 
              target="_blank" 
              rel="noopener noreferrer"
              class="btn-external"
            >
              {externalBtnText}
            </a>
          </div>
        </header>

        <CategoryProductCatalog
          locale={locale}
          uiCategorySlug={slug}
          uiName={uiName}
          products={products}
        />

        {products.length === 0 && (
          <p class="no-products">{content.categoryPage.noProducts}</p>
        )}
      </div>
    </section>
  </main>

  <SiteFooter
    locale={locale}
    disclaimerTitle={content.footer.disclaimerLabel}
    disclaimerHtml={content.footer.disclaimerHtml}
    copyrightLine={content.footer.copyrightLine}
  />
</Layout>

<style>
  .category-page {
    padding-bottom: 4rem;
  }
  .page-head {
    margin-bottom: 3rem;
    text-align: center;
  }
  .breadcrumb {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .breadcrumb a {
    text-decoration: none;
    color: var(--accent-dark);
  }
  .section-intro {
    max-width: 42rem;
    margin: 0 auto 1.5rem;
  }
  .header-actions {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }
  .btn-external {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.25rem;
    background: #fff;
    color: var(--accent-dark);
    border: 2px solid var(--accent-dark);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-external:hover {
    background: var(--accent-dark);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(233, 19, 98, 0.15);
  }

  .no-products {
    text-align: center;
    padding: 4rem 0;
    color: var(--muted);
  }
</style>
