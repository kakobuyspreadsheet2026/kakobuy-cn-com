---
import { absoluteCanonicalUrl } from '../../lib/canonicalPath';
import Layout from '../../layouts/Layout.astro';
import LocaleHomeStub from '../../components/LocaleHomeStub.astro';
import { frHome } from '../../i18n/stubs/fr';
import { kakobuyHomeHeroBannerUrl, siteStructuredDataIds } from '../../consts';
import { getHotProductsLd } from '../../lib/hotProductsLd';

export const prerender = true;

const locale = 'fr';
const canonicalPath = '/fr/';
const origin = Astro.site?.origin ?? 'https://kakobuy-cn.com';
const { websiteId } = siteStructuredDataIds(origin);
const pageUrl = absoluteCanonicalUrl(canonicalPath, Astro.site);

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  name: frHome.webPageName,
  url: pageUrl,
  description: frHome.description,
  inLanguage: 'fr',
  isPartOf: { '@id': websiteId },
  keywords: frHome.webPageKeywords,
};

const hotProductsLd = getHotProductsLd(origin);
---

<Layout
  locale={locale}
  title={frHome.title}
  description={frHome.description}
  canonicalPath={canonicalPath}
  i18nRouteSegment=""
  jsonLd={[webPageLd, hotProductsLd]}
  showDiscordTopBanner={false}
  lcpPreloadImages={[kakobuyHomeHeroBannerUrl]}
>
  <LocaleHomeStub content={frHome} />
</Layout>
