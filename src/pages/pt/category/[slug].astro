---
import { absoluteCanonicalUrl } from '../../../lib/canonicalPath';
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import CategoryProductCatalog from '../../../components/CategoryProductCatalog.astro';
import { siteStructuredDataIds } from '../../../consts';
import categories from '../../../data/api/categories.json';
import categoryProducts from '../../../data/api/category-products.json';
import { ptHome } from '../../../i18n/stubs/pt';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { filterRenderableCatalogProducts } from '../../../lib/catalogProducts';
import { productDetailHref, productDetailAbsoluteUrl } from '../../../lib/productDetailRoutes';
import { productSchemaRatingFields } from '../../../lib/productAggregateRating';
import { breadcrumbListLd } from '../../../lib/breadcrumbSchema';

export const prerender = true;

export function getStaticPaths() {
  const mapping = {
    'shoes': 'sneakers',
    't-shirts': 't-shirts',
    'pants': 'trousers-pants',
    'accessories': 'accessories',
    'bags': 'bags-backpacks',
    'electronics': 'electronics',
    'jackets': 'jackets',
    'hoodies': 'hoodies-sweatshirts',
    'headwear': 'headwear',
    'jersey': 'jersey',
    'perfume': 'perfume',
    'other': 'clothing'
  };

  return Object.keys(mapping).map((uiSlug) => {
    const apiSlug = mapping[uiSlug];
    return {
      params: { slug: uiSlug },
      props: { 
        apiSlug, 
        uiName: uiSlug.charAt(0).toUpperCase() + uiSlug.slice(1).replace('-', ' ') 
      }
    };
  });
}

const { slug } = Astro.params;
const { apiSlug, uiName } = Astro.props;

const locale = 'pt';
const content = ptHome;
const canonicalPath = `/${locale}/category/${slug}`;
const products = filterRenderableCatalogProducts(categoryProducts[apiSlug] || []);

const uiNameLower = uiName.toLowerCase();
const title = content.categoryPage.titleTemplate
  .replace('{uiName}', uiName);
const description = content.categoryPage.descriptionTemplate
  .replace('{uiName}', uiName)
  .replace('{uiNameLower}', uiNameLower);
const introText = content.categoryPage.introTemplate
  .replace('{uiNameLower}', uiNameLower);
const externalBtnText = content.categoryPage.externalBtnTemplate
  .replace('{uiName}', uiName);

const origin = Astro.site?.origin ?? 'https://kakobuy-cn.com';
const { websiteId } = siteStructuredDataIds(origin);
const pageUrl = absoluteCanonicalUrl(canonicalPath, Astro.site);

const breadcrumbLd = breadcrumbListLd([
  { name: 'Home', url: getRelativeLocaleUrl(locale, '') ? absoluteCanonicalUrl(getRelativeLocaleUrl(locale, ''), Astro.site) : `${origin}/` },
  { name: uiName, url: pageUrl },
]);

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': title,
  'numberOfItems': products.length,
  'itemListElement': products.map((p, i) => ({
    '@type': 'ListItem',
    'position': i + 1,
    'item': {
      '@type': 'Product',
      'name': p.title,
      'image': p.images[0],
      'brand': { '@type': 'Brand', 'name': p.brand },
      'offers': {
        '@type': 'Offer',
        'price': p.priceUsdEstimate[0],
        'priceCurrency': 'USD',
        'url': productDetailAbsoluteUrl(locale, slug, p.slug, Astro.site),
        'availability': 'https://schema.org/InStock',
        'shippingDetails': {
          '@type': 'OfferShippingDetails',
          'shippingRate': {
            '@type': 'MonetaryAmount',
            'value': '5.00',
            'currency': 'USD'
          },
          'shippingDestination': {
            '@type': 'DefinedRegion',
            'addressCountry': 'US'
          },
          'deliveryTime': {
            '@type': 'ShippingDeliveryTime',
            'handlingTime': {
              '@type': 'QuantitativeValue',
              'minValue': 1,
              'maxValue': 3,
              'unitCode': 'd'
            },
            'transitTime': {
              '@type': 'QuantitativeValue',
              'minValue': 7,
              'maxValue': 15,
              'unitCode': 'd'
            }
          }
        },
        'hasMerchantReturnPolicy': {
          '@type': 'MerchantReturnPolicy',
          'applicableCountry': 'US',
          'returnPolicyCategory': 'https://schema.org/MerchantReturnFiniteReturnPeriod',
          'merchantReturnDays': 7,
          'returnMethod': 'https://schema.org/ReturnByMail',
          'returnFees': 'https://schema.org/FreeReturn'
        }
      },
      ...productSchemaRatingFields(p.slug),
    }
  }))
};
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  locale={locale}
  jsonLd={[itemListLd, breadcrumbLd]}
>
  <SiteHeader locale={locale} />

  <main class="category-page">
    <section class="band-alt">
      <div class="wrap">
        <header class="page-head">
          <nav class="breadcrumb">
            <a href={getRelativeLocaleUrl(locale, '')}>Home</a> / <span>{uiName}</span>
          </nav>
          <h1 class="simple-page-title">{uiName} Spreadsheet 2026</h1>
          <p class="section-intro">
            {introText}
          </p>
          <div class="header-actions">
            <a 
              href={`https://maisonlooks.com/c/${apiSlug}`} 
              target="_blank" 
              rel="noopener noreferrer"
              class="btn-external"
            >
              {externalBtnText}
            </a>
          </div>
        </header>

        <CategoryProductCatalog
          locale={locale}
          uiCategorySlug={slug}
          uiName={uiName}
          products={products}
        />

        {products.length === 0 && (
          <p class="no-products">{content.categoryPage.noProducts}</p>
        )}
      </div>
    </section>
  </main>

  <SiteFooter
    locale={locale}
    disclaimerTitle={content.footer.disclaimerLabel}
    disclaimerHtml={content.footer.disclaimerHtml}
    copyrightLine={content.footer.copyrightLine}
  />
</Layout>

<style>
  .category-page {
    padding-bottom: 4rem;
  }
  .page-head {
    margin-bottom: 3rem;
    text-align: center;
  }
  .breadcrumb {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .breadcrumb a {
    text-decoration: none;
    color: var(--accent-dark);
  }
  .section-intro {
    max-width: 42rem;
    margin: 0 auto 1.5rem;
  }
  .header-actions {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }
  .btn-external {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.25rem;
    background: #fff;
    color: var(--accent-dark);
    border: 2px solid var(--accent-dark);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-external:hover {
    background: var(--accent-dark);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(233, 19, 98, 0.15);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .product-card {
    background: var(--surface);
    border-radius: 0.85rem;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 12px 24px rgba(255, 30, 111, 0.08);
  }

  .img-container {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--bg);
  }

  .img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .qc-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--accent-dark);
    color: #fff;
    padding: 0.2rem 0.5rem;
    border-radius: 0.4rem;
    font-size: 0.65rem;
    font-weight: 700;
  }

  .card-info {
    padding: 1.15rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .prod-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .price {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
  }

  .featured-tag {
    font-size: 0.625rem;
    font-weight: 800;
    color: #eab308;
    background: #fefce8;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #fef08a;
  }

  .no-products {
    text-align: center;
    padding: 4rem 0;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.85rem;
    }
  }
</style>
