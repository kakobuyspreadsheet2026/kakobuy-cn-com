---
import { absoluteCanonicalUrl } from '../../lib/canonicalPath';
import Layout from '../../layouts/Layout.astro';
import LocaleHomeStub from '../../components/LocaleHomeStub.astro';
import { ptHome } from '../../i18n/stubs/pt';
import { kakobuyHomeHeroBannerUrl, kakobuyHomeHeroMobileBannerUrl, siteStructuredDataIds } from '../../consts';
import { getHotProductsLd } from '../../lib/hotProductsLd';
import { homeFaqPageLd } from '../../lib/homeFaqLd';

export const prerender = true;

const locale = 'pt';
const canonicalPath = '/pt/';
const origin = Astro.site?.origin ?? 'https://kakobuy-cn.com';
const { websiteId } = siteStructuredDataIds(origin);
const pageUrl = absoluteCanonicalUrl(canonicalPath, Astro.site);

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  name: ptHome.webPageName,
  url: pageUrl,
  description: ptHome.description,
  inLanguage: 'pt',
  isPartOf: { '@id': websiteId },
  keywords: ptHome.webPageKeywords,
};

const hotProductsLd = getHotProductsLd(origin);
const faqLd = homeFaqPageLd(pageUrl, ptHome.sections);
---

<Layout
  locale={locale}
  title={ptHome.title}
  description={ptHome.description}
  canonicalPath={canonicalPath}
  i18nRouteSegment=""
  jsonLd={[webPageLd, hotProductsLd, faqLd]}
  showDiscordTopBanner={false}
  lcpPreloadImages={[kakobuyHomeHeroBannerUrl]}
  mobileLcpPreloadImages={[kakobuyHomeHeroMobileBannerUrl]}
>
  <LocaleHomeStub content={ptHome} />
</Layout>
