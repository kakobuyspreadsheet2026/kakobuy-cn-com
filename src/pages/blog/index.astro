---
import Layout from '../../layouts/Layout.astro';
import BlogPageBody from '../../components/pages/BlogPageBody.astro';
import blogPosts from '../../data/blogPosts.json';
import { siteStructuredDataIds } from '../../consts';
import { getBlogCopy } from '../../i18n/copy/blogPage';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { HTML_LANG_BY_ROUTE } from '../../i18n/config';

export const prerender = true;

const locale = 'en';
const canonicalPath = '/blog';
const copy = getBlogCopy(locale);
const homeHref = getRelativeLocaleUrl(locale, '');

const origin = Astro.site?.origin ?? 'https://kakobuy-cn.com';
const { websiteId } = siteStructuredDataIds(origin);
const pageUrl = new URL(canonicalPath, Astro.site).href;

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${pageUrl}#webpage`,
  name: copy.title,
  url: pageUrl,
  description: copy.description,
  inLanguage: HTML_LANG_BY_ROUTE[locale],
  isPartOf: { '@id': websiteId },
};
---

<Layout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath}
  locale={locale}
  i18nRouteSegment="blog"
  jsonLd={webPageLd}
>
  <BlogPageBody locale={locale} copy={copy} homeHref={homeHref} posts={blogPosts} />
</Layout>
