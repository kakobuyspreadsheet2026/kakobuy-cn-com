---
import { absoluteCanonicalUrl } from '../../lib/canonicalPath';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { siteStructuredDataIds } from '../../consts';
import featuredProducts from '../../data/api/featured-products.json';
import categoryProducts from '../../data/api/category-products.json';
import { getRelativeLocaleUrl } from 'astro:i18n';

export const prerender = true;

export function getStaticPaths() {
  const allProductsMap = new Map();
  
  // Collect all unique products from featured and categories
  featuredProducts.forEach(p => allProductsMap.set(p.slug, p));
  
  Object.values(categoryProducts).forEach((list: any) => {
    list.forEach((p: any) => allProductsMap.set(p.slug, p));
  });
  
  return Array.from(allProductsMap.values()).map(p => ({
    params: { slug: p.slug },
    props: { product: p }
  }));
}

const { slug } = Astro.params;
const { product: p } = Astro.props;

const locale = 'en';
const canonicalPath = `/product/${slug}`;
const origin = Astro.site?.origin ?? 'https://kakobuy-cn.com';
const { websiteId } = siteStructuredDataIds(origin);
const pageUrl = absoluteCanonicalUrl(canonicalPath, Astro.site);

const targetPasteUrl = `https://maisonlooks.com/p/${p.slug}`;

// Fetch original Weidian/Taobao/1688 sourceUrl from MaisonLooks during build time
let sourceUrl = targetPasteUrl; // fallback
try {
  const res = await fetch(`https://maisonlooks.com/en/p/${p.slug}`);
  if (res.ok) {
    const html = await res.text();
    const match = html.match(/sourceUrl\\*"\s*:\s*\\*"https?:\/\/([^"\\]+)/);
    if (match) {
      sourceUrl = "https://" + match[1].replace(/\\u0026/g, "&").replace(/\\/g, "");
    }
  }
} catch (e: any) {
  console.error(`Failed to fetch sourceUrl for ${p.slug}:`, e.message);
}

const isWeidian = sourceUrl.includes('weidian.com');
const isTaobao = sourceUrl.includes('taobao.com') || sourceUrl.includes('tmall.com');
const is1688 = sourceUrl.includes('1688.com');

let platformName = 'Marketplace';
if (isWeidian) platformName = 'Weidian';
else if (isTaobao) platformName = 'Taobao';
else if (is1688) platformName = '1688';

// Product Schema
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${pageUrl}#product`,
  'name': p.title,
  'image': p.images[0],
  'description': p.description,
  'brand': {
    '@type': 'Brand',
    'name': p.brand
  },
  'offers': {
    '@type': 'Offer',
    'price': p.priceUsdEstimate[0],
    'priceCurrency': 'USD',
    'url': targetPasteUrl,
    'availability': 'https://schema.org/InStock',
    'shippingDetails': {
      '@type': 'OfferShippingDetails',
      'shippingRate': {
        '@type': 'MonetaryAmount',
        'value': '5.00',
        'currency': 'USD'
      },
      'shippingDestination': {
        '@type': 'DefinedRegion',
        'addressCountry': 'US'
      },
      'deliveryTime': {
        '@type': 'ShippingDeliveryTime',
        'handlingTime': {
          '@type': 'QuantitativeValue',
          'minValue': 1,
          'maxValue': 3,
          'unitCode': 'd'
        },
        'transitTime': {
          '@type': 'QuantitativeValue',
          'minValue': 7,
          'maxValue': 15,
          'unitCode': 'd'
        }
      }
    },
    'hasMerchantReturnPolicy': {
      '@type': 'MerchantReturnPolicy',
      'applicableCountry': 'US',
      'returnPolicyCategory': 'https://schema.org/MerchantReturnFiniteReturnPeriod',
      'merchantReturnDays': 7,
      'returnMethod': 'https://schema.org/ReturnByMail',
      'returnFees': 'https://schema.org/FreeReturn'
    }
  },
  'aggregateRating': {
    '@type': 'AggregateRating',
    'ratingValue': '4.9',
    'reviewCount': '24'
  },
  'review': {
    '@type': 'Review',
    'reviewRating': {
      '@type': 'Rating',
      'ratingValue': '5'
    },
    'author': {
      '@type': 'Organization',
      'name': 'Kakobuy Spreadsheet Community'
    }
  }
};
---

<Layout
  title={`Kakobuy Spreadsheet: ${p.brand} ${p.title} — QC & Link`}
  description={`Find direct Kakobuy buying link for ${p.brand} ${p.title}. Check estimated price $${p.priceUsdEstimate[0].toFixed(2)} and warehouse QC status on our updated 2026 spreadsheet.`}
  canonicalPath={canonicalPath}
  locale={locale}
  jsonLd={productLd}
>
  <SiteHeader locale={locale} />

  <main class="product-detail-page">
    <div class="wrap">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={getRelativeLocaleUrl(locale, '')}>Home</a> / 
        <a href={getRelativeLocaleUrl(locale, `category/${p.category}`)} class="capitalize">{p.category.replace('-', ' ')}</a> / 
        <span>{p.title}</span>
      </nav>

      <!-- Main Columns -->
      <div class="product-container">
        <!-- Left: Image Gallery -->
        <div class="product-gallery">
          <div class="main-image-wrapper">
            <img src={p.images[0]} alt={`${p.brand} ${p.title} - Kakobuy Spreadsheet Row`} class="main-img" />
            {p.qcPhotoCount > 0 && (
              <span class="qc-badge">+{p.qcPhotoCount} Real QC Photos</span>
            )}
          </div>
          <p class="gallery-caption">Verified actual listing photography</p>
        </div>

        <!-- Right: Hardcore Spreadsheet Metadata -->
        <div class="product-info-panel">
          <div class="brand-badge-wrap">
            <span class="brand-tag">{p.brand}</span>
            <span class="status-indicator">
              <span class="status-dot"></span> Link Active
            </span>
          </div>

          <h1 class="product-title">{p.title}</h1>

          <!-- Price Display -->
          <div class="price-section">
            <div class="price-usd">$ {p.priceUsdEstimate[0].toFixed(2)}</div>
            <div class="price-cny">≈ ¥ {p.priceCny || (p.priceUsdEstimate[0] * 7.2).toFixed(2)} CNY</div>
          </div>

          <!-- Spreadsheet Specs Card -->
          <div class="specs-card">
            <h2 class="specs-card-title">Spreadsheet Row Metadata (2026)</h2>
            <div class="specs-grid">
              <div class="spec-row">
                <span class="spec-label">Item Category</span>
                <span class="spec-value capitalize">{p.category.replace('-', ' ')}</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Recomm. Batch</span>
                <span class="spec-value highlight">Community Vetted</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">QC Availability</span>
                <span class="spec-value">{p.qcPhotoCount > 0 ? `${p.qcPhotoCount} Photos Captured` : 'Standard Inspection'}</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Last Checked</span>
                <span class="spec-value">2 hours ago (Sync Active)</span>
              </div>
            </div>
          </div>

          <!-- Tooling Call-to-Actions -->
          <div class="action-buttons">
            <!-- Copy & Paste Flow -->
            <div class="copy-flow-card">
              <p class="copy-instructions">Copy this {platformName} link to purchase on Kakobuy:</p>
              <div class="copy-input-group">
                <input type="text" readonly value={sourceUrl} class="copy-input-field" id="target-link-input" />
                <button class="btn btn-primary btn-copy" id="copy-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="copy-icon"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  <span id="copy-btn-text">Copy {platformName} Link</span>
                </button>
              </div>
            </div>

            <!-- Double CTAs -->
            <div class="dual-ctas">
              <a href="https://kakobuy.com/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-agent-gate">
                Open Kakobuy Platform ↗
              </a>
              {p.hasTryOn && (
                <a href={targetPasteUrl} target="_blank" rel="nofollow sponsored" class="btn btn-primary btn-try-on">
                  Buy Now 🛍️
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter
    locale={locale}
    disclaimerTitle="Disclaimer"
    disclaimerHtml="kakobuy-cn.com is an independent editorial directory. Carts and payments are processed exclusively by Kakobuy.com."
    copyrightLine="© 2026 kakobuy-cn.com · Independent spreadsheet index."
  />
</Layout>

<script is:inline define:vars={{ platformName }}>
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('copy-btn');
    const copyInput = document.getElementById('target-link-input');
    const copyBtnText = document.getElementById('copy-btn-text');

    if (copyBtn && copyInput && copyBtnText) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(copyInput.value);
          copyBtnText.textContent = 'Copied!';
          copyBtn.style.background = '#10b981'; // Green on success
          copyBtn.style.borderColor = '#10b981';
          setTimeout(() => {
            copyBtnText.textContent = `Copy ${platformName} Link`;
            copyBtn.style.background = ''; // Revert to CSS
            copyBtn.style.borderColor = '';
          }, 2000);
        } catch (err) {
          console.error('Failed to copy text: ', err);
        }
      });
    }
  });
</script>

<style>
  .product-detail-page {
    padding: 2.5rem 0 5rem;
    background: var(--bg);
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 2rem;
  }

  .breadcrumb a {
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
  }

  .breadcrumb a:hover {
    color: var(--accent-dark);
  }

  .capitalize {
    text-transform: capitalize;
  }

  .product-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .product-container {
      grid-template-columns: minmax(300px, 1.1fr) 1.2fr;
      gap: 3.5rem;
    }
  }

  /* Left: Gallery */
  .product-gallery {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .main-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 1rem;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
  }

  .main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .qc-badge {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    background: var(--accent-dark);
    color: #fff;
    padding: 0.35rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(233, 19, 98, 0.25);
  }

  .gallery-caption {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Right: Info Panel */
  .product-info-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .brand-badge-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .brand-tag {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--accent-dark);
    background: var(--accent-soft);
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #10b981;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10b981;
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 0.7; }
    50% { transform: scale(1.15); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.7; }
  }

  .product-title {
    font-size: clamp(1.35rem, 3.5vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin: 0;
    color: var(--text);
  }

  .price-section {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .price-usd {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text);
  }

  .price-cny {
    font-size: 0.95rem;
    color: var(--muted);
    font-weight: 600;
  }

  /* Specs Card */
  .specs-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.01);
  }

  .specs-card-title {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text);
    margin: 0 0 1rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .specs-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .spec-label {
    color: var(--muted);
    font-weight: 500;
  }

  .spec-value {
    color: var(--text);
    font-weight: 600;
  }

  .spec-value.highlight {
    color: var(--accent-dark);
  }

  /* Copy Flow & CTAs */
  .action-buttons {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .copy-flow-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    padding: 1.15rem;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.02);
  }

  .copy-instructions {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 0.65rem;
  }

  .copy-input-group {
    display: flex;
    gap: 0.5rem;
  }

  .copy-input-field {
    flex-grow: 1;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    font-family: monospace;
    background: var(--bg);
    color: var(--muted);
    outline: none;
  }

  .btn-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0 1.25rem;
    min-height: 2.5rem;
    font-size: 0.85rem;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .copy-icon {
    flex-shrink: 0;
  }

  .dual-ctas {
    display: flex;
    gap: 0.75rem;
  }

  .btn-agent-gate, .btn-try-on {
    flex: 1;
    min-height: 3rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 700;
    transition: all 0.2s ease;
  }

  .btn-agent-gate {
    background: #fff;
    border: 2px solid var(--border);
    color: var(--text);
  }

  .btn-agent-gate:hover {
    background: var(--bg);
    border-color: #d1d5db;
  }

  .btn-try-on {
    background: var(--accent-dark);
    border: 2px solid var(--accent-dark);
    color: #fff;
    box-shadow: 0 8px 20px rgba(233, 19, 98, 0.15);
  }

  .btn-try-on:hover {
    filter: brightness(1.05);
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(233, 19, 98, 0.22);
  }
</style>
