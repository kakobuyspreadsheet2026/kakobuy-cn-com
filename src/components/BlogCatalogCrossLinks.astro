---
import { getRelativeLocaleUrl } from 'astro:i18n';
import {
  BLOG_HUB_LINK_LABELS,
  blogSlugFromCanonical,
  getBlogHubLinkKind,
  getBlogHubLinkSegment,
} from '../lib/blogCatalogCrossLinkMap';
import { PILLAR_HUB_GUIDES } from '../lib/relatedBlogGuides';
import { getSpreadsheetBrowseCategories } from '../lib/spreadsheetCatalogLinks';
import { productDetailHref } from '../lib/productDetailRoutes';

interface Props {
  locale?: string;
  canonicalPath: string;
  /** UI category slugs to highlight, e.g. ['shoes', 'hoodies']. */
  categories: string[];
  title?: string;
}

const {
  locale = 'en',
  canonicalPath,
  categories: categorySlugs,
  title = 'Browse related Kakobuy Spreadsheet picks',
} = Astro.props;

const currentSlug = blogSlugFromCanonical(canonicalPath);
const pillarLinks = PILLAR_HUB_GUIDES.filter((guide) => guide.slug !== currentSlug);

const lanes = getSpreadsheetBrowseCategories().filter((cat) =>
  categorySlugs.includes(cat.slug),
);

const hubKind = getBlogHubLinkKind(canonicalPath);
const homeHref = getRelativeLocaleUrl(locale, '');
const howToBuyHref = getRelativeLocaleUrl(locale, 'how-to-buy/');
const primaryHubHref = getRelativeLocaleUrl(locale, getBlogHubLinkSegment(hubKind));
const primaryHubLabel = BLOG_HUB_LINK_LABELS[hubKind];
---

{
  lanes.length > 0 && (
    <aside class="blog-catalog-links" aria-labelledby="blog-catalog-links-heading">
      <h2 id="blog-catalog-links-heading" class="blog-catalog-links__title">{title}</h2>
      <ul class="blog-catalog-links__list">
        {lanes.map((cat) => (
          <li class="blog-catalog-links__item">
            <a href={getRelativeLocaleUrl(locale, `category/${cat.slug}/`)} class="blog-catalog-links__cat">
              {cat.label} Spreadsheet ({cat.productCount} picks)
            </a>
            {cat.sampleSlug && (
              <span class="blog-catalog-links__sample-wrap">
                {' · '}
                <a href={productDetailHref(locale, cat.slug, cat.sampleSlug)} class="blog-catalog-links__sample">
                  Sample row
                </a>
              </span>
            )}
          </li>
        ))}
      </ul>
      <p class="blog-catalog-links__foot">
        {
          hubKind === 'home' ? (
            <>
              Browse{' '}
              <a href={primaryHubHref}>{primaryHubLabel}</a>
              {' · '}
              <a href={howToBuyHref}>How to buy</a>
            </>
          ) : hubKind === 'spreadsheet' ? (
            <>
              Full hub:{' '}
              <a href={primaryHubHref}>{primaryHubLabel}</a>
              {' · '}
              <a href={homeHref}>Home catalogue</a>
            </>
          ) : (
            <>
              Next step:{' '}
              <a href={primaryHubHref}>{primaryHubLabel}</a>
              {' · '}
              <a href={homeHref}>Kakobuy Spreadsheet home</a>
            </>
          )
        }
        {pillarLinks.length > 0 ? (
          <>
            {' · '}
            Hub guides:{' '}
            {pillarLinks.map((guide, i) => (
              <>
                {i > 0 ? ' · ' : null}
                <a href={`/blog/${guide.slug}/`}>{guide.title.replace(' (2026)', '')}</a>
              </>
            ))}
          </>
        ) : null}
      </p>
    </aside>
  )
}

<style>
  .blog-catalog-links {
    margin: 2rem 0 0;
    padding: 1.1rem 1.2rem;
    border-radius: 0.55rem;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .blog-catalog-links__title {
    margin: 0 0 0.65rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }

  .blog-catalog-links__list {
    margin: 0;
    padding-left: 1.15rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--text);
  }

  .blog-catalog-links__item {
    margin-bottom: 0.35rem;
  }

  .blog-catalog-links__cat,
  .blog-catalog-links__sample {
    color: var(--accent-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .blog-catalog-links__cat:hover,
  .blog-catalog-links__sample:hover {
    text-decoration: underline;
  }

  .blog-catalog-links__foot {
    margin: 0.85rem 0 0;
    font-size: 0.86rem;
    color: var(--muted);
  }

  .blog-catalog-links__foot a {
    color: var(--accent-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .blog-catalog-links__foot a:hover {
    text-decoration: underline;
  }
</style>
