---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { mlSpreadsheetKakobuy } from '../consts';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const onsiteSpreadsheetHref = getRelativeLocaleUrl(locale, 'spreadsheet');
const howToBuyHref = getRelativeLocaleUrl(locale, 'how-to-buy');
const buyerSharesHref = getRelativeLocaleUrl(locale, 'buyer-shares');
---

<section class="blog-end-cta" aria-labelledby="blog-end-cta-heading">
  <h2 id="blog-end-cta-heading" class="blog-end-cta__title">
    Next: Kakobuy Spreadsheet &amp; checkout prep
  </h2>
  <p class="blog-end-cta__lead">
    Ready to move from notes to links? Open the Kakobuy Spreadsheet catalogue (new tab), skim our{' '}
    <a href={onsiteSpreadsheetHref}>on-domain spreadsheet guide</a>
    {' '}when you want context, then walk through the how-to-buy guide before you paste marketplace URLs into your Kakobuy session—warehouse QC and shipping choices stay on Kakobuy. Crowd timelines live on{' '}
    <a href={buyerSharesHref}>Buyer shares</a>.
  </p>
  <div class="cta-row blog-end-cta__actions">
    <a
      class="btn btn-primary"
      href={mlSpreadsheetKakobuy}
      target="_blank"
      rel="noopener noreferrer">Open spreadsheet catalogue →</a
    >
    <a class="btn btn-ghost" href={howToBuyHref}>How to buy →</a>
  </div>
</section>

<style>
  .blog-end-cta {
    margin: 2rem 0 0;
    padding: 1.25rem 1.35rem 1.35rem;
    border-radius: 0.65rem;
    border: 1px solid var(--border);
    background: linear-gradient(180deg, var(--accent-soft, rgba(255, 30, 111, 0.08)) 0%, var(--surface) 42%);
    box-shadow: 0 8px 24px rgba(26, 26, 26, 0.06);
    text-align: center;
  }

  .blog-end-cta__title {
    margin: 0 0 0.55rem;
    font-size: 1.12rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.3;
  }

  .blog-end-cta__lead {
    margin: 0 auto 1.1rem;
    max-width: 42rem;
    font-size: 0.94rem;
    line-height: 1.62;
    color: var(--muted);
    text-align: left;
  }

  .blog-end-cta__lead a {
    color: var(--accent-dark);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .blog-end-cta__lead a:hover {
    color: var(--accent);
  }

  .blog-end-cta__actions {
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .blog-end-cta__actions .btn-primary {
    background: var(--accent-dark);
    border-color: var(--accent-dark);
    color: #fff;
    font-weight: 700;
    padding: 0.72rem 1.35rem;
    font-size: 0.95rem;
  }

  .blog-end-cta__actions .btn-primary:hover {
    filter: brightness(1.06);
  }

  .blog-end-cta__actions .btn-ghost {
    font-weight: 700;
    padding: 0.72rem 1.25rem;
    font-size: 0.95rem;
  }
</style>
