---
import products from '../data/api/featured-products.json';

interface Product {
  slug: string;
  title: string;
  category: string;
  brand: string;
  priceCny: string | number;
  priceUsdEstimate: [number, number];
  images: string[];
  qcPhotoCount: number;
}

const displayProducts = (products as Product[]).slice(0, 20);
---

<section class="hot-products">
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title">Editor's Pick: Trending Finds</h2>
      <p class="section-intro">
        A curated selection of high-quality items trending in the community. Each find includes verified buying links and QC references.
      </p>
    </header>

    <div class="table-container">
      <table class="products-table">
        <thead>
          <tr>
            <th>Preview</th>
            <th>Product Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {displayProducts.map((p) => (
            <tr>
              <td class="col-img">
                <div class="img-wrapper">
                  <img 
                    src={p.images[0]} 
                    alt={`Kakobuy Spreadsheet find - ${p.title}`}
                    loading="lazy"
                    width="60"
                    height="60"
                  />
                </div>
              </td>
              <td class="col-name">
                <span class="brand-tag">{p.brand}</span>
                <div class="prod-title">{p.title}</div>
              </td>
              <td class="col-cat">
                <span class="cat-badge">{p.category.replace('-', ' ')}</span>
              </td>
              <td class="col-price">
                <div class="price-cny">¥{p.priceCny}</div>
                <div class="price-usd">~${p.priceUsdEstimate[0].toFixed(2)}</div>
              </td>
              <td class="col-action">
                <a 
                  href={`https://maisonlooks.com/p/${p.slug}`} 
                  target="_blank" 
                  rel="nofollow sponsored"
                  class="btn-view"
                >
                  View on Kakobuy
                </a>
                {p.qcPhotoCount > 0 && (
                  <span class="qc-tag">+{p.qcPhotoCount} QC</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    
    <div class="table-footer">
      <a href="/spreadsheet/" class="btn-more">View Full 10,000+ Items Spreadsheet →</a>
    </div>
  </div>
</section>

<style>
  .hot-products {
    padding: 4rem 0;
    background: var(--surface-alt, #f9fafb);
  }
  .section-head {
    margin-bottom: 2.5rem;
    text-align: center;
  }
  .section-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .section-intro {
    max-width: 36rem;
    margin: 0 auto;
    color: var(--muted);
    line-height: 1.6;
  }
  
  .table-container {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  
  .products-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  
  .products-table th {
    background: #f8fafc;
    padding: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  
  .products-table td {
    padding: 1rem;
    vertical-align: middle;
    border-bottom: 1px solid var(--border);
  }
  
  .products-table tr:last-child td {
    border-bottom: none;
  }
  
  .img-wrapper {
    width: 60px;
    height: 60px;
    border-radius: 0.5rem;
    overflow: hidden;
    background: #f1f5f9;
  }
  
  .img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .brand-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-dark, #0f766e);
    text-transform: uppercase;
    letter-spacing: 0.025em;
    margin-bottom: 0.25rem;
  }
  
  .prod-title {
    font-weight: 600;
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  
  .cat-badge {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    background: #f1f5f9;
    color: #475569;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: capitalize;
  }
  
  .price-cny {
    font-weight: 700;
    color: var(--text);
    font-size: 1rem;
  }
  
  .price-usd {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  
  .btn-view {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--accent-dark, #0f766e);
    color: #fff;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }
  
  .btn-view:hover {
    background: #115e59;
  }
  
  .qc-tag {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: #059669;
    font-weight: 600;
  }
  
  .table-footer {
    margin-top: 2rem;
    text-align: center;
  }
  
  .btn-more {
    font-weight: 600;
    color: var(--accent-dark, #0f766e);
    text-decoration: none;
  }
  
  .btn-more:hover {
    text-decoration: underline;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .products-table thead {
      display: none;
    }
    .products-table tr {
      display: block;
      padding: 1rem;
      border-bottom: 1px solid var(--border);
    }
    .products-table td {
      display: block;
      padding: 0.25rem 0;
      border-bottom: none;
    }
    .col-img {
      float: left;
      margin-right: 1rem;
      padding: 0 !important;
    }
    .col-name {
      margin-bottom: 0.5rem;
    }
    .col-action {
      clear: both;
      padding-top: 0.75rem !important;
    }
    .btn-view {
      width: 100%;
      text-align: center;
    }
  }
</style>
