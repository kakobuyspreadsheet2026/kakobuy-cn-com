---
import type { RelatedGuideEntry } from '../lib/relatedBlogGuides';

interface Props {
  heading: string;
  intro?: string;
  guides: readonly RelatedGuideEntry[];
  id?: string;
}

const { heading, intro, guides, id = 'related-blog-guides' } = Astro.props;
---

{
  guides.length > 0 && (
    <aside class="related-guides" aria-labelledby={id}>
      <h2 id={id} class="related-guides__title">
        {heading}
      </h2>
      {intro ? <p class="related-guides__intro">{intro}</p> : null}
      <ul class="related-guides__list">
        {guides.map((guide) => (
          <li class="related-guides__item">
            <a href={`/blog/${guide.slug}/`} class="related-guides__link">
              {guide.title}
            </a>
            <span class="related-guides__desc"> — {guide.description}</span>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .related-guides {
    margin: 2rem 0 0;
    padding: 1.15rem 1.2rem;
    border-radius: 0.55rem;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .related-guides__title {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }

  .related-guides__intro {
    margin: 0 0 0.75rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .related-guides__list {
    margin: 0;
    padding-left: 1.15rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--text);
  }

  .related-guides__item {
    margin-bottom: 0.45rem;
  }

  .related-guides__link {
    color: var(--accent-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .related-guides__link:hover {
    text-decoration: underline;
  }

  .related-guides__desc {
    color: var(--muted);
  }
</style>
